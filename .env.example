PGHOST=your_database_host
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=your_database_user
PGPASSWORD=replace_with_your_database_password
PORT=3000
# Optional HTTPS: set both to PEM file paths to serve HTTPS instead of HTTP
# TLS_CERT_FILE=certs/localhost-cert.pem
# TLS_KEY_FILE=certs/localhost-key.pem
SML_SALES_FLAG=your_sales_flag

# Run node scripts/setup-auth.js to create the administrator account.
AUTH_USERNAME=
# Do not enter a plain password here. Generate this value with: node scripts/setup-auth.js
AUTH_PASSWORD_HASH=
# Keep true for the public Cloudflare HTTPS website. False is for local HTTP development only.
AUTH_COOKIE_SECURE=true

# Optional. Key that encrypts Super Admin TOTP secrets. If empty, data/2fa.key is generated next to the database (back it up, never commit it).
AUTH_2FA_KEY=
# Super Admin 2FA is required by default. false is for local development/tests only.
# AUTH_REQUIRE_2FA=true

# TikTok Shop Open API (Partner Center › แอป: คีย์ของแอป / ข้อมูลลับของแอป / ID ที่หัวหน้าแอป). See MARKETPLACE.md.
# Partner Center Redirect URL must be https://<your-domain>/api/tiktok/callback
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
# Optional: auto-pull the last 3 days every N minutes (minimum 30). Empty = manual sync only.
# TIKTOK_AUTO_SYNC_MINUTES=60
# Optional one-off history import from this day to today (92-day chunks, resumes after restart, runs once).
# TIKTOK_BACKFILL_FROM=2025-07-01

# Lazada Open Platform (open.lazada.com › App Management: App Key / App Secret). See MARKETPLACE.md › Lazada API.
# App Callback URL must equal LAZADA_REDIRECT_URI, e.g. https://<your-domain>/api/lazada/callback
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URI=
# Optional: auto-pull the last 3 days every N minutes (minimum 30). Empty = off.
# LAZADA_AUTO_SYNC_MINUTES=60
# LAZADA_BACKFILL_FROM=2025-07-01

# Google Sheets copy of the online-sales data (MARKETPLACE.md › Google Sheets). Key file = service account JSON in data/ (never commit).
# GOOGLE_SHEETS_KEY_FILE=data/google-sheets-key.json
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_EVERY_HOURS=5

# Shopee Open Platform v2 (open.shopee.com › Console › App: Partner ID / Partner Key). See MARKETPLACE.md › Shopee API.
# SHOPEE_ENV=sandbox uses the test partner + sandbox host; switch to live (with the live Partner ID/Key) after Go-Live.
# SHOPEE_REDIRECT_URL must be on the domain registered for the app, e.g. https://<your-domain>/api/shopee/callback
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ENV=sandbox
SHOPEE_REDIRECT_URL=
# SHOPEE_AUTO_SYNC_MINUTES=60# Optional host override, e.g. SHOPEE_HOST=https://openplatform.sandbox.test-stable.shopee.sg for newer sandbox apps
# SHOPEE_HOST=
